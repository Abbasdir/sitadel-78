# Copier ce fichier vers .env (exclu de Git), puis renseigner la cle localement.
# Ne pas partager la cle dans le chat ou dans le depot.
# Gemini : creer une cle sur https://aistudio.google.com/api-keys dans un projet Free Tier.
# Garder la facturation desactivee. Le script ne peut pas lire le statut de facturation du compte.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Recherche : compte Researcher Free sur https://app.tavily.com (1000 credits / mois).
# Ne pas activer pay-as-you-go. Facultatif si les URL sont fournies dans data/ref/sources_web.csv.
TAVILY_API_KEY=
